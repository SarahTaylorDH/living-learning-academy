# Copy to .env for local builds, or set these in your hosting dashboard.
# None of these are secret: they are written into the public website.

# The live address of the site (used for SEO links and the sitemap)
SITE_URL=https://livinglearningacademy.com

# Supabase → Project Settings → API Keys / Data API
# Use the Project URL and the PUBLISHABLE (or "anon public") key ONLY.
# NEVER put the secret / service_role key here: it would be public.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Address shown when the form is not connected or fails
CONTACT_EMAIL=info@livinglearningacademy.com

# Stripe Payment Link for online donations (https://buy.stripe.com/...). Leave blank to hide the button.
DONATE_URL=

# Set to true once confirmation emails are set up (see docs/EMAILS.md)
EMAILS_ENABLED=false
